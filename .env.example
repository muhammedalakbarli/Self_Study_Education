# Supabase konfiqurasiyası.
# Bu faylı `.env.local` adı ilə kopyalayın və real dəyərləri yazın.
# Dəyərləri Supabase layihənizin panelindən götürün: Settings > API.
# Qeyd: `.env.local` git-ə əlavə olunmur (gizli qalır).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Yalnız seed skripti üçün (GİZLİ — heç kimlə paylaşma, commit olunmur).
# Supabase > Settings > API > service_role açarı.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Analitika (PostHog) — funnel + retensiya ölçmək üçün. İSTƏYƏ BAĞLI:
# açar qoyulmasa analitika tam söndürülü qalır (heç nə sınmır).
# posthog.com-da pulsuz layihə yarat → Project Settings > Project API Key.
# Host: EU üçün https://eu.i.posthog.com , US üçün https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_YOUR-PROJECT-KEY
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Web Push (re-engagement bildirişləri). VAPID açar cütü.
# Yaratmaq: `node -e "console.log(require('web-push').generateVAPIDKeys())"`.
# Public → client (abunə üçün). Private → GİZLİ, yalnız server/cron (göndərmə üçün).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
VAPID_PRIVATE_KEY=YOUR-VAPID-PRIVATE-KEY
VAPID_SUBJECT=mailto:info@example.com

# Re-engagement göndəricisi (/api/cron/reminders) qorumaq üçün.
# Təsadüfi yarat: `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`.
# GitHub Actions (.github/workflows/cron-reminders.yml) bu dəyəri repo secret kimi
# oxuyub `Authorization: Bearer <CRON_SECRET>` başlığı ilə göndərir — həm burada
# (Worker secret), həm GitHub-da (Settings > Secrets > Actions) EYNİ dəyər olmalıdır.
CRON_SECRET=YOUR-RANDOM-SECRET

# ── Imparo Plus ödəniş (LemonSqueezy — Merchant of Record) ──
# 1) lemonsqueezy.com-da mağaza + iki abunə məhsulu (aylıq/illik) yarat.
# 2) Hər məhsulun "Share / Buy link" (hosted checkout) linkini bura yaz:
NEXT_PUBLIC_LS_CHECKOUT_MONTHLY=https://YOUR-STORE.lemonsqueezy.com/checkout/buy/VARIANT-ID-MONTHLY
NEXT_PUBLIC_LS_CHECKOUT_YEARLY=https://YOUR-STORE.lemonsqueezy.com/checkout/buy/VARIANT-ID-YEARLY
# 3) Settings > Webhooks: URL = https://SƏNIN-DOMEN/api/webhooks/lemonsqueezy ,
#    "subscription_*" və "order_created" hadisələrini seç, signing secret-i bura yaz (GİZLİ):
LEMONSQUEEZY_WEBHOOK_SECRET=YOUR-WEBHOOK-SIGNING-SECRET
