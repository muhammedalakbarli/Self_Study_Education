{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imparo",
  "pages_build_output_dir": ".open-next/assets",
  "assets": {
    "directory": ".open-next/assets"
  },
  "compatibility_date": "2025-06-01",
  "observability": {
    "enabled": true
  },
  "env": {
    "production": {
      "routes": [
        {
          "pattern": "imparo.pages.dev",
          "zone_name": "imparo.pages.dev"
        }
      ]
    }
  }
}
